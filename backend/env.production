# Backend Production Environment Template
# Copy this file to .env and fill in your production values
# IMPORTANT: Never commit .env to git - it contains secrets

# PostgreSQL Database Configuration (Required)
# Example: postgresql://prod_user:secure_password@prod-db-server.com:5432/lynko_prod
DATABASE_URL=postgresql://username:password@prod-db-host:5432/lynko_prod
DB_HOST=prod-db-host
DB_PORT=5432
DB_USER=prod_user
DB_PASSWORD=secure_password
DB_NAME=lynko_prod

# OpenAI API Configuration (Required - Get from https://platform.openai.com/api-keys)
# Example: sk-proj-5VzGl7K8jH...
OPENAI_API_KEY=sk-your_actual_production_key
OPENAI_MODEL=gpt-3.5-turbo

# Server Configuration
PORT=5000
NODE_ENV=production

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# CORS Configuration - Update to your frontend domain
# Example: https://yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Anthropic API (if using Anthropic models)
ANTHROPIC_API_KEY=your_anthropic_key_if_needed
