# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lynko_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DATABASE_URL=postgresql://username:password@localhost:5432/lynko_db

# OpenAI API Configuration (REQUIRED for ChatGPT integration)
# Get your API key from: https://platform.openai.com/account/api-keys
# Make sure your API key has permissions for Chat Completions API
OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional: Specify OpenAI model (default: gpt-3.5-turbo)
# Available models: gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview, etc.
OPENAI_MODEL=gpt-3.5-turbo

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Configuration (for future integration)
ANTHROPIC_API_KEY=your_anthropic_api_key_here